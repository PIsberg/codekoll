<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.codekoll</groupId>
    <artifactId>codekoll-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>codekoll-load-test</artifactId>
  <name>codekoll-load-test</name>
  <description>Perf harness: corpora, CPU/heap measurement, baseline gate, per-version charts.
    Internal only, never shipped.</description>

  <properties>
    <!-- Internal harness, never shipped; measured code is the analyzer, not this module. -->
    <checkstyle.skip>true</checkstyle.skip>
    <pmd.skip>true</pmd.skip>
    <spotbugs.skip>true</spotbugs.skip>
    <jacoco.skip>true</jacoco.skip>
    <!-- Regression thresholds vs the committed baseline (PLAN M9). -->
    <loadtest.cpu.maxRegression>0.15</loadtest.cpu.maxRegression>
    <loadtest.heap.maxRegression>0.20</loadtest.heap.maxRegression>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.codekoll</groupId>
      <artifactId>codekoll-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.codekoll</groupId>
      <artifactId>codekoll-rules</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <profiles>
    <!-- quick: small corpus + one 100 kLOC run; wired to CI on every build. -->
    <profile>
      <id>quick</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>loadtest-quick</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>io.codekoll.loadtest.LoadTestRunner</mainClass>
                  <arguments>
                    <argument>quick</argument>
                    <argument>${loadtest.cpu.maxRegression}</argument>
                    <argument>${loadtest.heap.maxRegression}</argument>
                    <argument>${project.basedir}</argument>
                    <argument>${maven.multiModuleProjectDirectory}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- full: all tiers, more iterations, regenerates docs/perf charts. -->
    <profile>
      <id>full</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.3</version>
            <executions>
              <execution>
                <id>loadtest-full</id>
                <phase>verify</phase>
                <goals><goal>java</goal></goals>
                <configuration>
                  <mainClass>io.codekoll.loadtest.LoadTestRunner</mainClass>
                  <arguments>
                    <argument>full</argument>
                    <argument>${loadtest.cpu.maxRegression}</argument>
                    <argument>${loadtest.heap.maxRegression}</argument>
                    <argument>${project.basedir}</argument>
                    <argument>${maven.multiModuleProjectDirectory}</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
