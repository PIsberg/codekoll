<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.codekoll</groupId>
    <artifactId>codekoll-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>codekoll-cli</artifactId>
  <name>codekoll-cli</name>
  <description>Command-line front-end; fat-jar entry point.</description>

  <dependencies>
    <dependency>
      <groupId>io.codekoll</groupId>
      <artifactId>codekoll-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.codekoll</groupId>
      <artifactId>codekoll-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.codekoll</groupId>
      <artifactId>codekoll-rules</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.codekoll</groupId>
      <artifactId>codekoll-report</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.codekoll</groupId>
      <artifactId>codekoll-workspace</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- Standing dogfooding gate (PLAN): the freshly shaded jar analyzes codekoll's own
             production sources on every verify, failing the build on any ERROR finding.
             No - -classpath needed: javac's fallback classpath is the fat jar itself, which
             bundles jspecify + picocli (see ARCHITECTURE.md).
             - -resolve none preserves exactly that. Milestone 11 made every run discover a
             workspace, and discovery hands javac a - -classpath assembled from build output on
             disk, which replaces the fat-jar fallback and leaves jspecify unresolvable: 55 of
             codekoll's own files stopped type-checking, so type-aware rules stopped running on
             them. A gate that goes quiet is worse than no gate (CLI-PLAN standing agreement 2).
             The path resolution needs is - -resolve build, which lands in Milestone 13. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>selfcheck</id>
            <phase>verify</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <arguments>
                <argument>-jar</argument>
                <argument>${project.build.directory}/codekoll.jar</argument>
                <argument>--fail-on</argument>
                <argument>error</argument>
                <argument>--resolve</argument>
                <argument>none</argument>
                <argument>${maven.multiModuleProjectDirectory}/codekoll-api/src/main/java</argument>
                <argument>${maven.multiModuleProjectDirectory}/codekoll-engine/src/main/java</argument>
                <argument>${maven.multiModuleProjectDirectory}/codekoll-rules/src/main/java</argument>
                <argument>${maven.multiModuleProjectDirectory}/codekoll-report/src/main/java</argument>
                <argument>${maven.multiModuleProjectDirectory}/codekoll-workspace/src/main/java</argument>
                <argument>${maven.multiModuleProjectDirectory}/codekoll-cli/src/main/java</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <finalName>codekoll</finalName>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.codekoll.cli.Main</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
